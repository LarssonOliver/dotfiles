{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "dark",
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(kubectl-readonly-strict *)",
      "Bash(helm list *)",
      "Bash(helm status *)",
      "Bash(helm history *)",
      "Bash(helm show *)",
      "Bash(helm search *)",
      "Bash(helm template *)",
      "Bash(helm lint *)",
      "Bash(helm diff *)",
      "Bash(kustomize build *)",
      "Bash(kubeconform *)",
      "Bash(kube-linter *)",
      "Bash(flux get *)",
      "Bash(clusterctl describe *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform plan *)",
      "Bash(terraform providers *)",
      "Bash(tofu fmt *)",
      "Bash(tofu validate *)",
      "Bash(tofu plan *)",
      "Bash(tflint *)",
      "Bash(gcloud config list *)",
      "Bash(gcloud container clusters list *)",
      "Bash(gcloud container clusters describe *)",
      "Bash(gcloud compute instances list *)",
      "Bash(shellcheck *)",
      "Bash(hadolint *)",
      "Bash(actionlint *)",
      "Bash(yamllint *)",
      "Bash(jq *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(npx tsc *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "WebFetch(domain:kubernetes.io)",
      "WebFetch(domain:helm.sh)",
      "WebFetch(domain:artifacthub.io)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:developer.hashicorp.com)",
      "WebFetch(domain:opentofu.org)",
      "WebFetch(domain:cloud.google.com)",
      "WebFetch(domain:cluster-api.sigs.k8s.io)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "ask": [
      "Bash(kubectl *)",
      "Bash(kubectl-readonly-strict *use-context*)",
      "Bash(kustomize build *--enable-*)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(helm rollback *)",
      "Bash(helm get *)",
      "Bash(helm *--post-renderer*)",
      "Bash(flux reconcile *)",
      "Bash(flux suspend *)",
      "Bash(flux resume *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform import *)",
      "Bash(terraform state *)",
      "Bash(terraform output *)",
      "Bash(terraform workspace select *)",
      "Bash(terraform show *)",
      "Bash(tofu apply *)",
      "Bash(tofu destroy *)",
      "Bash(tofu import *)",
      "Bash(tofu state *)",
      "Bash(tofu output *)",
      "Bash(tofu show *)",
      "Bash(gcloud config set *)",
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(gh pr merge *)",
      "Bash(docker push *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.tfstate)",
      "Read(*.tfstate.backup)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(kubeconfig*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/kube-context-guard.sh"
          }
        ]
      }
    ]
  }
}
