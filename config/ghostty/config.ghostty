theme = Nord
palette = 8=#4C566A
cursor-text = #2E3440

font-family = "SauceCodePro NFM"
font-size = 12
font-thicken = true

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

macos-option-as-alt = true
gtk-titlebar = false

bell-features = no-system,no-audio,no-attention,no-title,no-border

keybind = ctrl+shift+enter=new_window
keybind = ctrl+slash=text:\x1f
